{
  "name": "cycling-route-finder",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "LIVE=1 vitest run",
    "typecheck": "tsc -b",
    "icons": "node scripts/gen-icons.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "build:data": "tsx scripts/build-poi/main.ts",
    "build:data:sample": "tsx scripts/build-poi/main.ts --fixture scripts/build-poi/fixtures/sample --sample",
    "sim": "tsx scripts/sim-recommendations.mts"
  },
  "dependencies": {
    "@fontsource/outfit": "^5.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "playwright": "^1.56.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22.12"
  }
}
